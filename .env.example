# Optional overrides. The defaults use config/league.yaml, data/players.csv,
# and instance/fantasy_draft.db.
FANTASY_DRAFT_CONFIG=config/league.yaml
FANTASY_DRAFT_PLAYERS=data/players.csv
FANTASY_DRAFT_DATABASE_URL=sqlite:///instance/fantasy_draft.db
FANTASY_DRAFT_CACHE_DIR=instance/cache
FANTASY_DRAFT_BACKUP_DIR=instance/backups

# Server-side provider credentials. Leave blank until configured.
FANTASYPROS_API_KEY=
FANTASYPROS_DATA_MODE=auto
FANTASYPROS_TIMEOUT_SECONDS=10
DYNASTYPROCESS_PLAYER_IDS_URL=https://raw.githubusercontent.com/dynastyprocess/data/master/files/db_playerids.csv

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_LIVE_TIMEOUT_SECONDS=5
OPENAI_DIAGNOSTIC_TIMEOUT_SECONDS=30
OPENAI_REASONING_EFFORT=low
OPENAI_PREFETCH_PICKS=3
SURVIVAL_SIMULATIONS=2000
